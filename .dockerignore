# =============================================================================
# Docker Ignore - Root Level
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Documentation
*.md
!README.md
docs/

# Tests
tests/
__tests__/
*.test.*
*.spec.*
coverage/
.coverage
htmlcov/

# Logs
logs/
*.log

# Environment files
.env
.env.*
!.env.example

# Cache
.cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
build/
dist/
*.egg-info/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
docker-compose*.yml
Dockerfile*

# Misc
.DS_Store
Thumbs.db
*.zip
*.tar.gz
